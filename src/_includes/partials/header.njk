{# Logo per Squarespace's per-page code injection: full wordmark, or a white or black square mark. #}
{% if logo %}{% set lg = logo %}{% elif collectionName %}{% set lg = logos['item:' + collectionName] %}{% elif listCollection %}{% set lg = logos['list:' + listCollection] %}{% else %}{% set lg = 'full' %}{% endif %}
<header class="site-header site-header--{{ headerTheme or 'light' }}">
  <a class="site-logo site-logo--{{ lg }}" href="/">
    {% if lg == 'mark-white' %}<img src="/images/brand/210128_PEAK-square-01.png" alt="{{ site.name }}" width="70" height="70">
    {% elif lg == 'mark-black' %}<img src="/images/brand/210128-PEAK-square-black-01.png" alt="{{ site.name }}" width="70" height="70">
    {% else %}<img src="/images/brand/peak-logo-header.png" alt="{{ site.name }}" width="223" height="70">{% endif %}
  </a>
  <button type="button" class="nav-burger" aria-expanded="false" aria-controls="site-nav" aria-label="Menu"><span></span><span></span></button>
  <nav class="site-nav" id="site-nav">
    {% for item in site.nav %}<a href="{{ item.href }}"{% if page.url == item.href or page.url.startsWith(item.href + 'category/') or (item.activeOnItems and page.url.startsWith(item.href)) %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}
  </nav>
</header>
