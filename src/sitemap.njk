---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in collections.all %}{% if p.url and not p.url.endsWith('.xml') %}
  <url><loc>{{ site.url }}{{ p.url | canonicalPath }}</loc>{% if p.data.date and p.data.collectionName %}<lastmod>{{ p.data.date | isoDay }}</lastmod>{% endif %}</url>
{%- endif %}{% endfor %}
</urlset>
